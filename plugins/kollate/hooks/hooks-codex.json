{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/kollate-hook.cmd capture",
            "commandWindows": "cmd /c \"${CLAUDE_PLUGIN_ROOT}/hooks/kollate-hook.cmd\" capture",
            "timeout": 15
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/kollate-hook.cmd capture",
            "commandWindows": "cmd /c \"${CLAUDE_PLUGIN_ROOT}/hooks/kollate-hook.cmd\" capture",
            "timeout": 3
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/kollate-hook.cmd reconcile",
            "commandWindows": "cmd /c \"${CLAUDE_PLUGIN_ROOT}/hooks/kollate-hook.cmd\" reconcile",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
